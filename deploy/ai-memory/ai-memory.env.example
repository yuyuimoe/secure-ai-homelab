# ai-memory runtime config for the OpenShell path.
#
# Read by the quadlet via EnvironmentFile= (systemd EnvironmentFile syntax).
# scripts/install-ai-memory.sh generates the root token when it writes this file
# (mode 600). No quotes on values: the quadlet ExecStart uses podman --env-file,
# which passes quotes through literally.

# --- Authentication --------------------------------------------------------
# Root bearer token. Setting it turns on authentication and, together with
# per-user API keys, multi-user attribution. Keep it secret.
AI_MEMORY_AUTH_TOKEN=<root-token>

# Enables DB users and native API keys (ai-memory user / api-key). Without it
# only the root bearer authenticates and `api-key add` fails with
# "multi-user not enabled". scripts/install-ai-memory.sh generates it.
AI_MEMORY_AUTH__TOKEN_PEPPER=<token-pepper>

# --- Host allow-list -------------------------------------------------------
# Sandboxes address the server as host.openshell.internal:49374; the container
# aliases are kept for local tests.
AI_MEMORY_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.openshell.internal,host.containers.internal

# --- Runtime ---------------------------------------------------------------
# The in-container 0.0.0.0 bind is a namespace requirement, not exposure.
AI_MEMORY_IN_CONTAINER=1
AI_MEMORY_DATA_DIR=/data

# --- Optional LLM ----------------------------------------------------------
# Provider used for memory consolidation. Empty = zero-LLM mode (capture,
# search and handoff still work).
AI_MEMORY_LLM_PROVIDER=
