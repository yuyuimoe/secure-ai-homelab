# Rauthy configuration for Secure AI Homelab.
#
# Read by the rauthy quadlet via EnvironmentFile=. This is systemd
# EnvironmentFile syntax, so quotes are allowed and stripped.
#
# scripts/install-rauthy.sh generates the encryption key, the active key id and
# the two Hiqlite secrets when it writes this file (mode 600), and fills in
# <idp> when you pass a domain. You only need to set BOOTSTRAP_ADMIN_EMAIL.
# Generate the secrets by hand with the commands in
# docs/guides/openshell-pangolin.md (Part 1.1).

# --- Public identity -------------------------------------------------------
# PUB_URL is the public authority only: NO scheme, Rauthy builds the scheme from
# LISTEN_SCHEME + PROXY_MODE. With proxy_mode=true that yields https.
PUB_URL=<idp>
PROXY_MODE=true
# The only proxy in front of Rauthy is the host-level Newt connector.
TRUSTED_PROXIES=127.0.0.1/32

# --- Listener --------------------------------------------------------------
# The quadlet uses host networking; bind loopback only.
LISTEN_ADDRESS=127.0.0.1
LISTEN_PORT_HTTP=8080
LISTEN_SCHEME=http

# --- WebAuthn (passkeys) ---------------------------------------------------
# RP_ID is the effective domain. RP_ORIGIN MUST include the port.
RP_ID=<idp>
RP_ORIGIN=https://<idp>:443

# --- Embedded database (Hiqlite, single node) ------------------------------
HQL_NODE_ID=1
HQL_NODES="1 localhost:8100 localhost:8200"
# Host networking means these must bind loopback, not 0.0.0.0.
HQL_LISTEN_ADDR_API=127.0.0.1
HQL_LISTEN_ADDR_RAFT=127.0.0.1
HQL_SECRET_RAFT=<raft-secret>
HQL_SECRET_API=<api-secret>

# --- Encryption keys -------------------------------------------------------
# Rauthy refuses to start without BOTH of these:
#   ENC_KEYS        one or more <key-id>/<32-byte-base64> entries
#   ENC_KEY_ACTIVE  the key id used for new encryptions (must match a key id)
# Generate with:
#   key_id=$(openssl rand -hex 4); key=$(openssl rand -base64 32)
#   echo "ENC_KEYS=$key_id/$key"; echo "ENC_KEY_ACTIVE=$key_id"
ENC_KEYS=<key-id>/<base64-32-bytes>
ENC_KEY_ACTIVE=<key-id>

# --- First administrator ---------------------------------------------------
# Also the login identifier. Change it to a real address you control.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Optional: set a strong password instead of reading the generated one from the
# first startup log. Leave unset to have Rauthy generate and log it once.
#BOOTSTRAP_ADMIN_PASSWORD_PLAIN=

# --- Email (optional) ------------------------------------------------------
# Needed for user invitations and password resets. Without SMTP you must create
# users and set passwords through the admin UI.
#SMTP_URL=
#SMTP_PORT=
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=Rauthy <rauthy@<idp>>
