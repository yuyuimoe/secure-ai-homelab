# Rauthy — OIDC identity provider for OpenShell and Pangolin.
#
# Rootless Podman quadlet. Install with scripts/install-rauthy.sh (copies this
# and rauthy-data.volume into ~/.config/containers/systemd/), then:
#
#   $EDITOR ~/.config/secure-ai-homelab/rauthy.env   # admin email
#   systemctl --user start rauthy.service
#
# Runtime settings are read from the env file via EnvironmentFile= (the same
# idiom as the ai-memory unit). See docs/guides/openshell-pangolin.md.

[Container]
Image=ghcr.io/sebadob/rauthy:0.37.1
ContainerName=rauthy

# Host networking on purpose. The host-level Newt connector reaches Rauthy on
# loopback, so Rauthy sees source 127.0.0.1 and `proxy_mode` trusted_proxies is
# deterministic. With a published port, pasta presents the host's own IP as the
# source and trusted_proxies cannot be pinned. LISTEN_ADDRESS and the Hiqlite
# listen addresses are set to 127.0.0.1 in the env file so nothing but loopback
# is bound on the host.
Network=host

# Embedded database and generated JWKS/JWT signing keys. Back this up.
Volume=rauthy-data.volume:/app/data

EnvironmentFile=%h/.config/secure-ai-homelab/rauthy.env

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
