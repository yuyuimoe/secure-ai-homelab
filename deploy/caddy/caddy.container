# Caddy — local TLS reverse proxy for Rauthy (used where Pangolin is absent).
#
# Rootless Podman quadlet. Install with scripts/install-caddy.sh, which copies
# this file and the two volumes into ~/.config/containers/systemd/, renders the
# Caddyfile, starts the unit and trusts Caddy's internal CA on the host.
#
# Host networking on purpose: Caddy proxies to Rauthy on 127.0.0.1:8080, so
# Rauthy sees source 127.0.0.1 and its TRUSTED_PROXIES=127.0.0.1/32 stays
# correct. Nothing but the configured HTTPS port is exposed.

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy

Network=host

# Rendered from deploy/caddy/Caddyfile by install-caddy.sh.
Volume=%h/.config/secure-ai-homelab/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data.volume:/data
Volume=caddy-config.volume:/config

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
