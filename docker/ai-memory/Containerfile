# Secure AI Homelab — ai-memory server (long-term memory: HTTP MCP at /mcp,
# lifecycle /hook, web UI). Built locally from the upstream release binary.
#
# Base: debian:bookworm-slim. Debian only needs baseline x86-64, so this runs on
# hosts whose CPU lacks x86-64-v2 (where a Wolfi base dies with
# "Fatal glibc error: CPU does not support x86-64-v2"). The upstream Rust binary
# is glibc-linked and needs glibc/libgcc/zlib plus CA certificates for outgoing
# HTTPS to LLM providers.

FROM docker.io/debian:bookworm-slim

ARG AI_MEMORY_VERSION=2.6.3
# Upstream release assets are named by architecture: amd64 -> x86_64,
# arm64 -> aarch64. TARGETARCH is set by BuildKit/Podman buildx.
ARG TARGETARCH

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl libgcc-s1 zlib1g; \
    case "${TARGETARCH:-amd64}" in \
        amd64|"") arch=x86_64 ;; \
        arm64)    arch=aarch64 ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/akitaonrails/ai-memory/releases/download/v${AI_MEMORY_VERSION}/ai-memory-linux-${arch}.tar.gz" -o /tmp/aim.tar.gz; \
    mkdir -p /opt/ai-memory /usr/local/share/ai-memory; \
    tar -xzf /tmp/aim.tar.gz -C /opt/ai-memory; \
    install -m 0755 /opt/ai-memory/ai-memory /usr/local/bin/ai-memory; \
    cp -a /opt/ai-memory/hooks /usr/local/share/ai-memory/hooks; \
    rm -rf /opt/ai-memory /tmp/aim.tar.gz; \
    apt-get purge -y curl; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

# Non-root service account owning /data (uid 1000). The unit runs with
# UserNS=keep-id so the named volume is owned by the host user.
RUN groupadd -g 1000 ai-memory \
    && useradd -u 1000 -g 1000 -M -d /data -s /usr/sbin/nologin ai-memory \
    && mkdir -p /data \
    && chown -R ai-memory:ai-memory /data

# AI_MEMORY_IN_CONTAINER tells `serve` the 0.0.0.0 bind is a namespace
# requirement, not evidence of network exposure (upstream issue #407).
ENV AI_MEMORY_DATA_DIR=/data \
    AI_MEMORY_IN_CONTAINER=1 \
    AI_MEMORY_ALLOWED_HOSTS="localhost,127.0.0.1,::1,host.docker.internal"

WORKDIR /data
EXPOSE 49374
ENTRYPOINT ["/usr/local/bin/ai-memory"]
CMD ["serve", "--transport", "http", "--bind", "0.0.0.0:49374", "--enable-web"]

USER ai-memory
