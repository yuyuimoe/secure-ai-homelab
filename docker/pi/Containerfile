# Secure AI Homelab — Pi workload image.
#
# Runs inside OpenShell sandboxes.
#
# Base: Wolfi (glibc + apk) with Bun. Wolfi gives glibc — required by the
# native agent binaries (pi-bolt and Claude Code) — while staying Alpine-small
# and CVE-light, consistent with the ai-memory image. The `pi` command is
# Pi-Bolt, an AOT-compiled Pi.
#
# The host must support x86-64-v2 or newer: Wolfi's glibc is built for v2, and
# pi-bolt / native Claude Code need SSE4.2.
#
# Pi-Bolt's native binary is normally fetched on first run into ~/.pi-bolt. That
# fetch happens here at build time with the runtime HOME so the image is
# self-contained — an OpenShell sandbox has deny-by-default network and could
# not download it at run time.

ARG AI_MEMORY_CLI_IMAGE=docker.io/akitaonrails/ai-memory:latest

# ai-memory CLI, used only to generate Pi's bridge extension at build time.
FROM ${AI_MEMORY_CLI_IMAGE} AS memory

FROM docker.io/chainguard/wolfi-base:latest

USER root

ARG PI_BOLT_VERSION=latest
ARG CLAUDE_CODE_CHANNEL=latest
ARG ZCODE_VERSION=latest
# Where sandboxes reach ai-memory (the OpenShell supervisor aliases it to host
# loopback). Must match deploy/ai-memory/provider-profile.yaml.
ARG AI_MEMORY_SERVER_URL=http://host.openshell.internal:49374

# Bun installs global packages under $BUN_INSTALL/bin.
ENV BUN_INSTALL=/usr/local \
    HOME=/root \
    PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# coreutils: Pi-Bolt's first-run installer checks its download with
# `sha256sum -c --quiet`, which busybox's sha256sum does not support (it would
# report a false "checksum mismatch"). The GNU sha256sum is required.
RUN apk add --no-cache \
        bash bun ca-certificates coreutils curl git jq openssl ripgrep xz \
    && rm -rf /var/cache/apk/*

# Bun is a drop-in replacement for Node, so tools that shell out to `node`
# (ZCode's launcher, Pi extensions) get a runtime without a second JS engine.
# Caveat: Bun's node mode does not implement `node --version`/`-v` (it does
# support scripts, shebangs and `-p`), so a tool that gates on the Node version
# string will misbehave here.
RUN mkdir -p /usr/local/bin && ln -sf "$(command -v bun)" /usr/local/bin/node

# --- Pi-Bolt (native Pi). `bun add -g --trust` runs the package's postinstall
# (places the launcher); running it once with the runtime HOME bakes the native
# binary so a sandbox never has to fetch it. `pi` is aliased to it so
# `vp run pi` / `pi` behave identically.
RUN bun add -g --trust "pi-bolt@${PI_BOLT_VERSION}" \
    && ln -sf /usr/local/bin/pi-bolt /usr/local/bin/pi \
    && mkdir -p /config \
    && HOME=/config pi-bolt --version

# --- Claude Code (native installer; glibc binary). Installed under a
# world-readable prefix because the workload runs as a non-root USER. ---------
RUN mkdir -p /opt/claude \
    && curl -fsSL https://claude.ai/install.sh | HOME=/opt/claude bash -s "${CLAUDE_CODE_CHANNEL}" \
    && chmod -R a+rX /opt/claude \
    && ln -sf /opt/claude/.local/bin/claude /usr/local/bin/claude \
    && claude --version

# --- ZCode (terminal client for the ZCode agent runtime). Its launcher shells
# out to `node`, which here is Bun (see the `node` symlink above). ------------
RUN bun add -g "zcode-app-cli@${ZCODE_VERSION}" \
    && zcode --version

# --- ai-memory bridge for Pi -----------------------------------------------
# Pi has no native MCP config, so ai-memory generates a TypeScript extension at
# ~/.pi/agent/extensions/ai-memory-pi.ts. It reads AI_MEMORY_AUTH_TOKEN from the
# environment at run time (the OpenShell provider fills it with an opaque
# placeholder the supervisor substitutes at the endpoint), so no secret is baked.
COPY --from=memory /usr/local/bin/ai-memory /usr/local/bin/ai-memory
RUN mkdir -p /config /tmp/ai-memory-build \
    && HOME=/config AI_MEMORY_DATA_DIR=/tmp/ai-memory-build AI_MEMORY_SERVER_URL="${AI_MEMORY_SERVER_URL}" \
         ai-memory install-hooks --agent pi --apply --server-url "${AI_MEMORY_SERVER_URL}" \
    && rm -rf /tmp/ai-memory-build \
    && test -f /config/.pi/agent/extensions/ai-memory-pi.ts

# Runtime HOME is the agent config dir, mirroring the upstream Pi image's
# /config layout.
ENV HOME=/config \
    SHELL=/bin/bash \
    TERM=xterm-256color \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    USE_BUILTIN_RIPGREP=0

RUN mkdir -p /config/.pi/agent /config/.claude /config/.zcode /workspace \
    && chmod 0755 /workspace

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# OpenShell rejects a workload image whose declared UID/GID is 0 ("workload
# identity must not contain UID or GID zero"), so run as 1000.
RUN addgroup -g 1000 pi \
    && adduser -u 1000 -G pi -h /config -s /bin/bash -D pi \
    && chown -R 1000:1000 /config /workspace
USER 1000:1000

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["pi"]
