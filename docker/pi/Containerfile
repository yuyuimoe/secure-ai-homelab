# Secure AI Homelab — Pi workload image.
#
# Runs inside OpenShell sandboxes (and, legacy, as VibePod's `pi` agent).
#
# Debian + Node, not Wolfi and not pi-bolt, because the target host CPU has no
# SSE4.2 (x86-64 baseline only):
#   * Wolfi's glibc is built for x86-64-v2: `Fatal glibc error: CPU does not
#     support x86-64-v2`.
#   * pi-bolt is an AOT native binary that requires SSE4.2 (`x64-baseline` too),
#     so it cannot run at all: "Pi-Bolt needs a CPU with SSE4.2".
#   * Claude Code 2.1.113+ is a native binary that spins at 100% CPU on such a
#     host; 2.1.112 is the last pure-JS release and runs on Node.
#   * Bun's global installer hangs on such a host, so npm is used throughout.
# The standard Pi agent (`@earendil-works/pi-coding-agent`) is pure JS on Node.

ARG AI_MEMORY_IMAGE=docker.io/akitaonrails/ai-memory:latest

# ai-memory CLI, used only to generate Pi's bridge extension at build time.
FROM ${AI_MEMORY_IMAGE} AS memory

FROM docker.io/library/node:22-slim

USER root

ARG PI_VERSION=latest
ARG ZCODE_VERSION=latest
ARG CLAUDE_CODE_VERSION=2.1.112
# Where sandboxes reach ai-memory (the OpenShell supervisor aliases it to host
# loopback). Must match deploy/ai-memory/provider-profile.yaml.
ARG AI_MEMORY_SERVER_URL=http://host.openshell.internal:49374

ENV HOME=/root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git gosu jq openssl passwd ripgrep tar xz-utils \
    && rm -rf /var/lib/apt/lists/*

# --- Pi (standard agent, pure JS on Node). `pi` is the real Pi command. -----
RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && pi --version

# --- Claude Code, pinned to the last pure-JS release. ----------------------
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

# --- ZCode (Node-based TUI). -----------------------------------------------
RUN npm install -g "zcode-app-cli@${ZCODE_VERSION}" \
    && zcode --version

# --- ai-memory bridge for Pi -----------------------------------------------
# Pi has no native MCP config, so ai-memory generates a TypeScript extension at
# ~/.pi/agent/extensions/ai-memory-pi.ts. It reads AI_MEMORY_AUTH_TOKEN from the
# environment at run time (the OpenShell provider fills it with an opaque
# placeholder the supervisor substitutes at the endpoint), so no secret is baked.
COPY --from=memory /usr/local/bin/ai-memory /usr/local/bin/ai-memory
RUN mkdir -p /config /tmp/ai-memory-build \
    && HOME=/config AI_MEMORY_DATA_DIR=/tmp/ai-memory-build AI_MEMORY_SERVER_URL="${AI_MEMORY_SERVER_URL}" \
         ai-memory install-hooks --agent pi --apply --server-url "${AI_MEMORY_SERVER_URL}" \
    && rm -rf /tmp/ai-memory-build \
    && test -f /config/.pi/agent/extensions/ai-memory-pi.ts

# Runtime HOME is the agent config dir (VibePod mounts the persisted config
# there), mirroring the upstream VibePod pi image's /config layout.
ENV HOME=/config \
    SHELL=/bin/bash \
    TERM=xterm-256color \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    USE_BUILTIN_RIPGREP=0

RUN mkdir -p /config/.pi/agent /config/.claude /config/.zcode /workspace \
    && chmod 0755 /workspace

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# OpenShell rejects a workload image whose declared UID/GID is 0 ("workload
# identity must not contain UID or GID zero"). Run as 1000 (the node image's
# `node` user); the entrypoint still honours VibePod's USER_UID/USER_GID remap
# when it happens to start as root.
RUN chown -R 1000:1000 /config /workspace
USER 1000:1000

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["pi"]
