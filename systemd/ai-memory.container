# ai-memory — long-term memory server (HTTP MCP at /mcp, web UI, /hook for
# lifecycle events). Runs in the pod's network namespace; agents spawned in
# PinP reach it through the inner podman's gateway at
# http://host.containers.internal:49374 (pasta alias). The VibePod profile
# wires each agent's ai-memory endpoint to that URL (scripts/setup.sh).

[Container]
# Built locally from docker/ai-memory/Containerfile (Wolfi base, upstream
# release binary) — no Docker Hub pull, so the stack stays self-hosted.
Image=localhost/vibepod-homelab/ai-memory:latest
ContainerName=ai-memory
Pod=vibepod.pod

# Match the control plane so the named volume is owned by the host user
# (image runs as uid/gid 1000).
UserNS=keep-id
User=1000
Group=1000

Volume=ai-memory-data.volume:/data

# Loopback on the host so you can open the web UI / curl the MCP endpoint.
PublishPort=127.0.0.1:49374:49374

Environment=RUST_LOG=ai_memory=info,ai_memory_store=info,ai_memory_wiki=info,ai_memory_mcp=info,tracing_appender=warn
# Runtime overrides (auth token, LLM provider, allowed hosts) come from a file
# generated by scripts/install.sh / update.sh out of .env. Podman reads it via
# --env-file; systemd expands %h to the user's home.
EnvironmentFile=%h/.config/vibepod-homelab/ai-memory.env

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
