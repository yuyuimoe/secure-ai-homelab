# One-shot seed (replaces the old compose `projects-init` service).
#
# The old service existed only because Docker Compose `volume.subpath` requires
# a subdirectory to exist before the sidecar mounts it. With whole-volume
# mounts (no subpath) that quirk is gone, but this still creates the agent
# config dirs and workspaces up front with the right owner so the first
# `vp run` and the inner podman start clean.

[Container]
Image=docker.io/library/alpine:3.22
ContainerName=vibepod-init

UserNS=keep-id
User=1000
Group=1000

Volume=vibepod-config.volume:/config
Volume=workspaces.volume:/workspaces

Exec=/bin/sh -c "mkdir -p /config/agents/pi/.pi/agent /config/agents/claude/.claude /config/agents/zcode /config/proxy /workspaces && chown -R 1000:1000 /config /workspaces"

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=default.target
