# PinP — Podman-in-Podman. The inner podman daemon VibePod spawns agent
# containers into. Replaces the old docker:dind sidecar.
#
# Rootless-in-rootless: the pod runs under the host user's rootless podman;
# inside this container the podman service runs as root *within the user
# namespace*. Nested containers need SYS_ADMIN (in the userns, not host-root)
# plus original supplementary groups so newuidmap/newgidmap can map the
# subuid/subgid ranges. Storage is vfs (no nested overlay). See
# docs/reference/deployment.md for the subuid/subgid prerequisite.

[Container]
Image=localhost/vibepod-homelab/pinp:latest
ContainerName=pinp
Pod=vibepod.pod

UserNS=keep-id
AddCapability=SYS_ADMIN
Annotation=run.oci.keep_original_groups=1
SecurityLabelDisable=true

# Storage + the shared socket.
Volume=pinp-data.volume:/var/lib/containers
Volume=pinp-socket.volume:/run/podman

# Shared at the SAME paths as the control plane so agent config-dir and
# workspace bind-mounts resolve inside the inner podman.
Volume=vibepod-config.volume:/home/developer/.config/vibepod
Volume=workspaces.volume:/home/developer/workspaces

Environment=CONTAINER_UID=1000
Environment=CONTAINER_GID=1000

[Unit]
After=init.service
Requires=init.service

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
