# VibePod Homelab — environment template.
# Copy to .env and edit. scripts/install.sh, scripts/update.sh and
# scripts/setup.sh source this file (set -a), so keep it valid shell syntax —
# quote any value containing spaces. The "Upstream pins" below are passed to
# `podman build --build-arg`; the AI_MEMORY_* runtime settings are written to
# the ai-memory service env file (~/.config/vibepod-homelab/ai-memory.env).
# The pod/container/image names are informational: the quadlets hard-code them.

# --- Pod / container names (informational) ---------------------------------
POD_NAME=vibepod-homelab
CONTROL_IMAGE=localhost/vibepod-homelab/control-plane:latest
PINP_IMAGE=localhost/vibepod-homelab/pinp:latest
AI_MEMORY_IMAGE=localhost/vibepod-homelab/ai-memory:latest

# --- Identity of the persistent volumes (must match your host user) --------
CONTAINER_UID=1000
CONTAINER_GID=1000

# --- Upstream pins (consumed by the build scripts) --------------------------
PI_BOLT_VERSION=latest
CLAUDE_CODE_CHANNEL=latest
ZCODE_VERSION=latest
SHELLCHECK_VERSION=0.10.0
AI_MEMORY_VERSION=2.6.3

# --- VibePod ----------------------------------------------------------------
# Agent launched when `vp run` is given no argument.
VP_DEFAULT_AGENT=pi
# The Pi agent runs the Pi-Bolt image built into PinP (fully self-hosted).
VP_IMAGE_PI=vibepod/pi-bolt:latest

# --- ai-memory (long-term memory server) ------------------------------------
# Empty = zero-LLM mode (capture/search/handoff all work with no API key).
AI_MEMORY_AUTH_TOKEN=
AI_MEMORY_LLM_PROVIDER=
AI_MEMORY_ALLOWED_HOSTS=localhost,127.0.0.1,host.containers.internal
# URL agents use to reach the server; must resolve from inside PinP.
AI_MEMORY_SERVER_URL=http://host.containers.internal:49374

# --- Git identity used by agents when they commit ---------------------------
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL=your-github-noreply@example.com
