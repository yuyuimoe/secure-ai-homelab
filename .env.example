# Secure AI Homelab — image build pins.
#
# Copy to .env and edit. scripts/install-ai-memory.sh sources this file, and the
# values match the `podman build --build-arg` names used in
# docs/guides/openshell-pangolin.md. The ai-memory service runtime settings live
# in deploy/ai-memory/ai-memory.env.example instead.

# --- Upstream pins (consumed by the image builds) ---------------------------
PI_BOLT_VERSION=latest
CLAUDE_CODE_CHANNEL=latest
ZCODE_VERSION=latest
AI_MEMORY_VERSION=2.6.3
# Image the Pi workload build copies the ai-memory CLI from (for its Pi bridge).
AI_MEMORY_CLI_IMAGE=docker.io/akitaonrails/ai-memory:latest
