#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vibepod-homelab"
CONFIG_FILE="$CONFIG_DIR/config"

fail() { echo "error: $*" >&2; exit 1; }

load_config() {
  [[ -f "$CONFIG_FILE" ]] || fail "VibePod Homelab is not installed. Run ./scripts/install.sh first."
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  [[ -n "${VIBEPOD_HOMELAB_DIR:-}" ]] || fail "VIBEPOD_HOMELAB_DIR is missing from $CONFIG_FILE"
  [[ -d "$VIBEPOD_HOMELAB_DIR" ]] || fail "Installation directory no longer exists: $VIBEPOD_HOMELAB_DIR"
}

usage() {
  cat <<'EOF'
Usage: vph <command> [options]

Commands:
  setup                    Build the Pi agent image into PinP + wire ai-memory
  login                    Authenticate agents and the GitHub CLI
  doctor                   Verify the whole stack
  connect                  Open a Herdr multiplexer session
  update                   Rebuild/update the stack, keeping persistent state
  up / down                Start / stop the pod (systemd units)
  status                   Show pod + container status
  logs                     Follow control-plane + PinP + ai-memory logs
  shell                    Open the Fish developer shell
  run <agent> [args...]    Run a VibePod agent (e.g. `vph run pi`)
  board <args...>          Run `vp board` in the control plane
  help                     Show this help
EOF
}

main() {
  local cmd=${1:-help}
  case "$cmd" in
    help|--help|-h) usage; exit 0 ;;
  esac

  load_config

  case "$cmd" in
    setup)    exec "$VIBEPOD_HOMELAB_DIR/scripts/setup.sh" ;;
    login)    exec "$VIBEPOD_HOMELAB_DIR/scripts/login.sh" ;;
    doctor)   exec "$VIBEPOD_HOMELAB_DIR/scripts/doctor.sh" ;;
    connect)  exec "$VIBEPOD_HOMELAB_DIR/scripts/connect.sh" ;;
    update)   exec "$VIBEPOD_HOMELAB_DIR/scripts/update.sh" ;;
    up)       systemctl --user start vibepod-pod.service ;;
    down)     systemctl --user stop vibepod-pod.service ;;
    status)   podman pod ps; podman ps -a ;;
    logs)     podman logs -f vibepod pinp ai-memory ;;
    shell)    podman exec -it vibepod fish ;;
    run)      shift; exec podman exec -it vibepod vp run "$@" ;;
    board)    shift; exec podman exec -it vibepod vp board "$@" ;;
    *)        fail "unknown command: $cmd (run 'vph help')" ;;
  esac
}

main "$@"
